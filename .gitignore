# Dependencias (Cubre raíz, backend y frontend)
node_modules/
**/node_modules/

# Variables de entorno y claves privadas
.env
*.env
**/.env

# Archivos comprimidos y de empaquetado
*.zip
*.tar.gz

# Archivos de compilación de frontend
dist/
build/
.vite/

# Archivos de subida y logs
logs/
*.log
src/uploads/*
!src/uploads/.gitkeep
backend/src/uploads/*
!backend/src/uploads/.gitkeep

# Base de datos local SQLite / dumps temporales
*.db
*.sqlite
*.dump
*.dump.sql
*.bak

# Permitir migraciones de base de datos de Prisma
!**/prisma/migrations/**/*.sql

# Configuración local de Claude Code (agentes, skills, reglas, ajustes): nunca se sube
.claude/
**/.claude/

# Archivos del sistema operativo y editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json