// ============================================================================
// CMMS THI S.A.S. — Esquema de base de datos (Prisma)
// Sprint 1 · Gestión de Equipos y Acceso — HU1, HU2, HU3, HU24
// Sprint 2 · Planificación del Mantenimiento — HU4, HU5, HU6, HU7, HU8
// Sprint 3 · Ejecución del Mantenimiento — HU9, HU10, HU11, HU12, HU13
// Sprint 4 · Órdenes de Trabajo y Alertas — HU14, HU15, HU16, HU17, HU18
// Servicios externos (HU1: mantenimiento externo, base de HU19)
// ============================================================================
// Los modelos de Sprint 5 (indicadores y reportes) se apoyan en los datos ya
// persistidos aquí; no requieren tablas nuevas salvo agregados de consulta.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumeraciones
// ---------------------------------------------------------------------------

// HU24 — Control de roles: administrador / técnico
enum Rol {
  ADMINISTRADOR
  TECNICO
}

// HU2 — Clasificación de activos
enum TipoActivo {
  EQUIPO
  INSUMO
  MATERIA_PRIMA
  CONSUMIBLE
}

enum EstadoEquipo {
  ACTIVO
  EN_MANTENIMIENTO
  DADO_DE_BAJA
}

enum ResponsableMantenimiento {
  INTERNO
  EXTERNO
}

// HU6 — Gestionar frecuencia del mantenimiento preventivo. SEMANAL es el caso
// principal del Sprint 2 (Sprint Planning: "lógica de frecuencia semanal";
// BPMN: "OT preventiva con las tareas de la semana"); el resto de valores
// queda disponible para no volver a migrar cuando se amplíe.
enum FrecuenciaMantenimiento {
  DIARIA
  SEMANAL
  QUINCENAL
  MENSUAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// HU5 — "nivel de prioridad" del mantenimiento programado.
enum PrioridadMantenimiento {
  BAJA
  MEDIA
  ALTA
  CRITICA
}
/** Public form of an intervention (HU23): weights and hours, without calculation fields. */

// Estado de una ocurrencia concreta del cronograma. En Sprint 2 solo se usan
// PROGRAMADO / ASIGNADO / CANCELADO; los estados de ejecución (EN_EJECUCION,
// COMPLETADO, NO_EJECUTADO) se activan en Sprint 3 y ya se dejan declarados.
enum EstadoMantenimientoProgramado {
  PROGRAMADO
  ASIGNADO
  EN_EJECUCION
  COMPLETADO
  NO_EJECUTADO
  CANCELADO
}

// Distingue una ocurrencia creada a mano por el administrador (HU5) de una
// materializada por el motor de frecuencia (HU6).
enum OrigenMantenimiento {
  MANUAL
  AUTOMATICO
}

// HU13 — motivo obligatorio de una tarea pendiente o de un mantenimiento no
// ejecutado. El criterio de aceptación nombra explícitamente "insumos o
// personal"; OTRO cubre el resto sin habilitar texto sin clasificar.
enum MotivoNoEjecucion {
  FALTA_INSUMOS
  FALTA_PERSONAL
  OTRO
}

// HU1 / HU19 / HU20 — naturaleza de un mantenimiento, interno (cronograma) o
// contratado a un tercero (servicio externo). Junto con quién lo hace da el
// "tipo de mantenimiento" del reporte de costos: Interno/Externo x
// Preventivo/Correctivo. Antes de Sprint 5 se llamaba NaturalezaServicioExterno
// (la migración lo renombra, no lo recrea: los datos se conservan).
enum NaturalezaMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

// HU14 — ciclo de vida de una orden de trabajo.
enum EstadoOrdenTrabajo {
  EMITIDA
  EN_PROCESO
  CERRADA
  CANCELADA
}

// HU17 — umbrales de anticipación del Product Backlog (15/8/1 días).
// HU18 — VENCIDA para los mantenimientos cuya fecha expiró sin ejecutarse.
enum TipoAlerta {
  PREVENTIVA_15D
  PREVENTIVA_8D
  PREVENTIVA_1D
  VENCIDA
}

enum EstadoAlerta {
  PENDIENTE
  LEIDA
  RESUELTA
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

// HU24 — Autenticación y control de acceso por rol
model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  passwordHash  String
  rol           Rol
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equiposRegistrados Equipo[] @relation("EquipoRegistradoPor")

  // Sprint 2 — Planificación del mantenimiento
  tareasCreadas             TareaMantenimiento[]      @relation("TareaCreadaPor")
  planesCreados             PlanMantenimiento[]       @relation("PlanCreadoPor")
  mantenimientosAsignados   MantenimientoProgramado[] @relation("MantenimientoTecnicoAsignado")
  mantenimientosGestionados MantenimientoProgramado[] @relation("MantenimientoAsignadoPor")

  // Sprint 3 — Ejecución del mantenimiento
  ejecuciones RegistroEjecucion[] @relation("EjecucionTecnico")

  // Sprint 4 — Órdenes de trabajo y alertas
  ordenesAsignadas OrdenTrabajo[] @relation("OrdenTecnicoAsignado")
  ordenesEmitidas  OrdenTrabajo[] @relation("OrdenEmitidaPor")
  alertasRecibidas Alerta[]       @relation("AlertaTecnicoDestino")

  // Servicios externos registrados por este usuario (auditoría de quién cargó cada costo).
  serviciosExternosRegistrados ServicioExterno[] @relation("ServicioExternoRegistradoPor")

  // Ley 1581 — aceptaciones del aviso de tratamiento de datos personales.
  consentimientos ConsentimientoTratamiento[] @relation("ConsentimientoDeUsuario")

  @@map("usuarios")
}

// HU1 — Tarjeta maestra de equipos · HU2 — Clasificación · HU3 — Consulta
model Equipo {
  id     String @id @default(uuid())
  nombre String

  // Código interno único (ej. "AC-102") — usado también como identificador
  // visible en OT, alertas y reportes en los sprints siguientes.
  referencia String @unique

  // HU1 / BPMN "Registrar nuevo equipo" — paso "Registrar código serial":
  // número de serie del FABRICANTE, distinto de `referencia` (que es el
  // código interno de THI). El BPMN 2 lo persiste en un paso separado
  // ("Guardar y asociar código serial al activo"), así que se valida y
  // guarda independientemente de los datos generales.
  numeroSerie String? @unique

  marca              String?
  anioAdquisicion    Int?
  zona               String
  tipoActivo         TipoActivo @default(EQUIPO)
  costo              Decimal?   @db.Decimal(14, 2)
  descripcionTecnica String?

  // HU1 — registro fotográfico y manual del equipo
  fotoUrl      String?
  manualPdfUrl String?

  estado            EstadoEquipo             @default(ACTIVO)
  tipoMantenimiento ResponsableMantenimiento @default(INTERNO)

  registradoPorId String
  registradoPor   Usuario @relation("EquipoRegistradoPor", fields: [registradoPorId], references: [id])

  // Sprint 2 — Planificación del mantenimiento
  planesMantenimiento       PlanMantenimiento[]
  mantenimientosProgramados MantenimientoProgramado[]

  // Sprint 3 — filas de tipoActivo INSUMO/CONSUMIBLE/MATERIA_PRIMA consumidas
  // en una ejecución (vínculo opcional; ver InsumoUtilizado).
  insumosUtilizados InsumoUtilizado[] @relation("InsumoDeEquipo")

  // Sprint 4 — Órdenes de trabajo y alertas del equipo
  ordenesTrabajo OrdenTrabajo[]
  alertas        Alerta[]

  // HU1 — hoja de vida: mantenimientos contratados a terceros.
  serviciosExternos ServicioExterno[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([zona])
  @@index([estado])
  @@index([tipoActivo])
  @@map("equipos")
}

// ---------------------------------------------------------------------------
// Sprint 2 · Planificación del Mantenimiento — HU4, HU5, HU6, HU7, HU8
// ---------------------------------------------------------------------------

// HU4 — Definir tareas de mantenimiento preventivo. Catálogo reutilizable:
// la tarea describe "qué se hace" (actividad, recursos, tiempo, frecuencia
// sugerida); el vínculo con un equipo concreto se hace en PlanMantenimiento.
// `recursos` es texto libre en Sprint 2 — el registro formal de insumos y
// repuestos llega en Sprint 3 (HU11).
model TareaMantenimiento {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  recursos    String?

  // "tiempo" del criterio de aceptación de HU4.
  duracionEstimadaMin Int?

  frecuenciaSugerida FrecuenciaMantenimiento?
  tipoMantenimiento  ResponsableMantenimiento @default(INTERNO)
  activa             Boolean                  @default(true)

  creadaPorId String
  creadaPor   Usuario @relation("TareaCreadaPor", fields: [creadaPorId], references: [id])

  planes                    PlanMantenimiento[]
  mantenimientosProgramados MantenimientoProgramado[]
  ordenesTrabajo            OrdenTrabajo[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([activa])
  @@map("tareas_mantenimiento")
}

// HU6 — Gestionar frecuencia. Es "la regla": una tarea aplicada a un equipo
// con una periodicidad. El motor de frecuencia materializa ocurrencias
// (MantenimientoProgramado) a partir de `fechaInicio` y `frecuencia`, sin
// pasar de `proximaGeneracionHasta` para no duplicar al re-ejecutar.
model PlanMantenimiento {
  id String @id @default(uuid())

  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id])

  tareaId String
  tarea   TareaMantenimiento @relation(fields: [tareaId], references: [id])

  frecuencia          FrecuenciaMantenimiento
  fechaInicio         DateTime
  prioridadPorDefecto PrioridadMantenimiento  @default(MEDIA)
  activo              Boolean                 @default(true)

  // Hasta qué fecha ya se generaron ocurrencias para este plan (idempotencia).
  proximaGeneracionHasta DateTime?

  creadoPorId String
  creadoPor   Usuario @relation("PlanCreadoPor", fields: [creadoPorId], references: [id])

  mantenimientosProgramados MantenimientoProgramado[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Un equipo no repite la misma tarea en dos planes distintos.
  @@unique([equipoId, tareaId])
  @@index([activo])
  @@map("planes_mantenimiento")
}

// HU5 — Programar mantenimiento (cronograma) · HU7 — Asignar a técnico ·
// HU8 — El técnico consulta las suyas. Es "el evento concreto con fecha".
// Se crea a mano (origen MANUAL, sin `planId`) o desde un plan (origen
// AUTOMATICO, con `planId`).
model MantenimientoProgramado {
  id String @id @default(uuid())

  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id])

  tareaId String
  tarea   TareaMantenimiento @relation(fields: [tareaId], references: [id])

  planId String?
  plan   PlanMantenimiento? @relation(fields: [planId], references: [id], onDelete: Restrict)

  fechaProgramada DateTime
  prioridad       PrioridadMantenimiento        @default(MEDIA)
  estado          EstadoMantenimientoProgramado @default(PROGRAMADO)
  origen          OrigenMantenimiento           @default(MANUAL)
  notas           String?

  // HU19 / HU20 — lo que sale de un plan es preventivo; el administrador puede
  // programar a mano un correctivo (una falla que hay que atender).
  naturaleza NaturalezaMantenimiento @default(PREVENTIVO)

  // HU7 — nulos hasta que el administrador asigna un técnico.
  tecnicoAsignadoId String?
  tecnicoAsignado   Usuario? @relation("MantenimientoTecnicoAsignado", fields: [tecnicoAsignadoId], references: [id], onDelete: Restrict)

  asignadoPorId String?
  asignadoPor   Usuario? @relation("MantenimientoAsignadoPor", fields: [asignadoPorId], references: [id], onDelete: Restrict)

  fechaAsignacion DateTime?

  // Sprint 3 — la ejecución concreta de este mantenimiento (1:1).
  registroEjecucion RegistroEjecucion?

  // Sprint 3 — ciclo del BPMN "Reprogramar mantenimiento": una ocurrencia que
  // quedó NO_EJECUTADA no se reabre (su registro de ejecución ya es evidencia
  // cerrada); se clona en una ocurrencia nueva que apunta aquí.
  reprogramadoDeId String?
  reprogramadoDe   MantenimientoProgramado?  @relation("Reprogramacion", fields: [reprogramadoDeId], references: [id], onDelete: Restrict)
  reprogramaciones MantenimientoProgramado[] @relation("Reprogramacion")

  // Sprint 4 — la OT formal que materializa este mantenimiento (1:1) y las
  // alertas preventivas / de vencimiento del motor de HU17-HU18.
  ordenTrabajo OrdenTrabajo?
  alertas      Alerta[]

  // HU1 — si esta ocurrencia del cronograma la realizó un proveedor externo,
  // el servicio contratado queda ligado aquí (y el mantenimiento pasa a COMPLETADO
  // sin RegistroEjecucion: no hubo técnico propio ni horas que medir).
  servicioExterno ServicioExterno?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([fechaProgramada])
  @@index([estado])
  @@index([tecnicoAsignadoId])
  @@index([equipoId])
  @@map("mantenimientos_programados")
}

// ---------------------------------------------------------------------------
// Sprint 3 · Ejecución del Mantenimiento — HU9, HU10, HU11, HU12, HU13
// ---------------------------------------------------------------------------

// HU9 — Registro de la ejecución de un MantenimientoProgramado (1:1). El
// técnico lo abre al iniciar (padre -> EN_EJECUCION, equipo -> EN_MANTENIMIENTO)
// y lo cierra al finalizar (padre -> COMPLETADO o NO_EJECUTADO). Tras fijarse
// `finalizadoEn` el registro y sus hijos quedan de solo lectura.
model RegistroEjecucion {
  id String @id @default(uuid())

  mantenimientoProgramadoId String                  @unique
  mantenimientoProgramado   MantenimientoProgramado @relation(fields: [mantenimientoProgramadoId], references: [id])

  // Técnico responsable de la ejecución (normalmente el asignado en HU7).
  tecnicoId String
  tecnico   Usuario @relation("EjecucionTecnico", fields: [tecnicoId], references: [id])

  // HU9 — "guarda fecha". Si se omite, se deriva de `horaInicio`.
  fechaEjecucion DateTime @default(now())

  // HU10 — hora de inicio y de finalización de la tarea.
  horaInicio        DateTime?
  horaFin           DateTime?
  minutosPausa      Int       @default(0)
  // Calculado al finalizar (horaFin - horaInicio - pausa) o cargado a mano.
  minutosTrabajados Int?

  // HU12 — "Número de técnicos" de la fórmula de costo. Entrada manual: HU7
  // asigna un único técnico responsable.
  numeroTecnicos Int @default(1)

  // HU9 — observaciones y firma (confirmación textual del técnico autenticado).
  observaciones String?
  firmaTecnico  String?

  // HU9 — evidencia fotográfica antes / después (almacenamiento local /uploads).
  evidenciaAntesUrl   String?
  evidenciaDespuesUrl String?

  // HU13 — si el mantenimiento no se ejecutó, el motivo es obligatorio.
  motivoNoEjecucion    String?
  categoriaNoEjecucion MotivoNoEjecucion?

  // HU12 — costos (snapshot congelado al finalizar).
  valorHoraManoObra Decimal? @db.Decimal(14, 2)
  costoManoObra     Decimal? @db.Decimal(14, 2)
  costoInsumos      Decimal? @db.Decimal(14, 2)
  costoTotal        Decimal? @db.Decimal(14, 2)

  finalizadoEn DateTime?

  insumos    InsumoUtilizado[]
  pendientes TareaPendiente[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tecnicoId])
  @@index([fechaEjecucion])
  @@map("registros_ejecucion")
}

// HU11 — Insumo, consumible o repuesto utilizado en una ejecución. `descripcion`
// es un snapshot obligatorio; `equipoInsumo` enlaza opcionalmente con una fila
// de Equipo cuyo tipoActivo sea INSUMO / CONSUMIBLE / MATERIA_PRIMA.
model InsumoUtilizado {
  id String @id @default(uuid())

  registroEjecucionId String
  registroEjecucion   RegistroEjecucion @relation(fields: [registroEjecucionId], references: [id], onDelete: Restrict)

  descripcion String

  equipoInsumoId String?
  equipoInsumo   Equipo? @relation("InsumoDeEquipo", fields: [equipoInsumoId], references: [id], onDelete: Restrict)

  cantidad      Decimal  @db.Decimal(14, 2)
  unidad        String?
  costoUnitario Decimal? @db.Decimal(14, 2)
  costoLinea    Decimal? @db.Decimal(14, 2)

  creadoEn DateTime @default(now())

  @@index([registroEjecucionId])
  // HU22 — el consumo de recursos se agrupa por insumo del inventario.
  @@index([equipoInsumoId])
  @@map("insumos_utilizados")
}

// HU13 — Hallazgo, avería adicional o tarea postergada detectada durante la
// ejecución. Aplica tanto a un mantenimiento COMPLETADO (hallazgos) como a uno
// NO_EJECUTADO. `categoria` (el motivo) es obligatoria.
model TareaPendiente {
  id String @id @default(uuid())

  registroEjecucionId String
  registroEjecucion   RegistroEjecucion @relation(fields: [registroEjecucionId], references: [id], onDelete: Restrict)

  descripcion String
  categoria   MotivoNoEjecucion
  prioridad   PrioridadMantenimiento @default(MEDIA)
  resuelta    Boolean                @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([registroEjecucionId])
  @@index([resuelta])
  @@map("tareas_pendientes")
}

// ---------------------------------------------------------------------------
// Sprint 4 · Órdenes de Trabajo y Alertas — HU14, HU15, HU16, HU17, HU18
// ---------------------------------------------------------------------------

// HU14 — Orden de trabajo formal. Se materializa desde un MantenimientoProgramado
// (1:1) o se emite por solicitud directa. El consecutivo institucional tiene la
// forma OT-<anio>-<numero> y se reinicia cada anio, por eso se guardan anio y
// numero por separado ademas del texto ya formateado.
model OrdenTrabajo {
  id String @id @default(uuid())

  consecutivo String @unique
  anio        Int
  numero      Int

  // Nulo cuando la OT nace de una solicitud directa (sin cronograma previo).
  mantenimientoProgramadoId String?                  @unique
  mantenimientoProgramado   MantenimientoProgramado? @relation(fields: [mantenimientoProgramadoId], references: [id], onDelete: Restrict)

  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id])

  tareaId String?
  tarea   TareaMantenimiento? @relation(fields: [tareaId], references: [id], onDelete: Restrict)

  tecnicoAsignadoId String?
  tecnicoAsignado   Usuario? @relation("OrdenTecnicoAsignado", fields: [tecnicoAsignadoId], references: [id], onDelete: Restrict)

  // Nulo cuando la OT la genera el sistema (HU14, emisión automática desde el
  // cronograma): no hay ningún usuario que la haya emitido. La base de datos
  // exige que una OT sin emisor sea AUTOMATICO. Restrict explícito: al volver
  // opcional la relación, Prisma pasaría por defecto a SET NULL y borrar un
  // usuario dejaría OT como si las hubiera emitido el sistema.
  emitidaPorId String?
  emitidaPor   Usuario? @relation("OrdenEmitidaPor", fields: [emitidaPorId], references: [id], onDelete: Restrict)

  descripcion String?
  prioridad   PrioridadMantenimiento @default(MEDIA)
  estado      EstadoOrdenTrabajo     @default(EMITIDA)
  origen      OrigenMantenimiento    @default(MANUAL)

  fechaEmision    DateTime  @default(now())
  fechaProgramada DateTime?
  fechaCierre     DateTime?

  observacionesCierre String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([anio, numero])
  @@index([estado])
  @@index([equipoId])
  @@index([tecnicoAsignadoId])
  @@index([fechaEmision])
  @@map("ordenes_trabajo")
}

// HU17 — alertas preventivas a 15, 8 y 1 dia de la fecha programada.
// HU18 — alerta VENCIDA cuando la fecha paso y el mantenimiento sigue sin
// ejecutarse. La unicidad (mantenimiento, tipo) hace idempotente al motor:
// re-ejecutarlo no duplica alertas.
model Alerta {
  id String @id @default(uuid())

  tipo   TipoAlerta
  estado EstadoAlerta @default(PENDIENTE)

  mantenimientoProgramadoId String
  mantenimientoProgramado   MantenimientoProgramado @relation(fields: [mantenimientoProgramadoId], references: [id], onDelete: Restrict)

  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id])

  // Tecnico al que le corresponde la alerta; nulo si aun no hay asignacion
  // (en ese caso solo la ve la administracion).
  tecnicoDestinoId String?
  tecnicoDestino   Usuario? @relation("AlertaTecnicoDestino", fields: [tecnicoDestinoId], references: [id], onDelete: Restrict)

  mensaje          String
  // Snapshot de la fecha del mantenimiento, para ordenar sin joins.
  fechaProgramada  DateTime
  // 15, 8 o 1 para las preventivas; nulo para VENCIDA.
  diasAnticipacion Int?

  leidaEn    DateTime?
  resueltaEn DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([mantenimientoProgramadoId, tipo])
  @@index([estado])
  @@index([tipo])
  @@index([tecnicoDestinoId])
  @@index([fechaProgramada])
  @@map("alertas")
}

// ---------------------------------------------------------------------------
// HU1 · Mantenimiento externo (base de los costos de HU19)
// ---------------------------------------------------------------------------

// Servicio de mantenimiento o reparación contratado a un proveedor. Es un
// modelo aparte de RegistroEjecucion porque el costo NO se calcula (horas x
// tarifa + insumos): es el valor facturado por el proveedor, tal como llega.
// La descripción es el texto explicativo del servicio y el informe del proveedor
// (PDF: manual, garantía o certificado) queda en la hoja de vida del equipo.
// Registro de retención: nada lo borra (onDelete Restrict en todas las
// relaciones) y solo lo administra el rol ADMINISTRADOR.
model ServicioExterno {
  id String @id @default(uuid())

  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id], onDelete: Restrict)

  // Opcional: el servicio cubre una ocurrencia del cronograma (un mantenimiento
  // que se tercerizó), con su misma naturaleza. A lo sumo un servicio por ocurrencia.
  mantenimientoProgramadoId String?                  @unique
  mantenimientoProgramado   MantenimientoProgramado? @relation(fields: [mantenimientoProgramadoId], references: [id], onDelete: Restrict)

  proveedor   String
  descripcion String
  naturaleza  NaturalezaMantenimiento

  // Se guarda a medianoche UTC, como el resto de fechas de calendario.
  fechaServicio  DateTime
  numeroFactura  String?
  // El valor facturado por el proveedor; la base de datos exige que no sea negativo.
  costoFacturado Decimal  @db.Decimal(14, 2)

  informePdfUrl String?

  registradoPorId String
  registradoPor   Usuario @relation("ServicioExternoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([equipoId, fechaServicio])
  @@index([fechaServicio])
  @@map("servicios_externos")
}

// ---------------------------------------------------------------------------
// Ley 1581 de 2012 · Autorización para el tratamiento de datos personales
// ---------------------------------------------------------------------------

// Constancia de que un usuario aceptó una versión del aviso de tratamiento de
// datos (firma de conformidad y fotografías de evidencia de la ejecución).
// Es un registro de PRUEBA: solo admite altas. Un disparador de la base de datos
// impide modificarlo o borrarlo, y cuando el aviso cambia se registra una
// aceptación nueva de la versión nueva, sin tocar las anteriores. La revocación
// de la autorización no se modela aquí: se atiende por el canal del responsable.
model ConsentimientoTratamiento {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation("ConsentimientoDeUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)

  // Identifica el texto aceptado (ver src/config/politicaDatos.js).
  versionPolitica String
  aceptadoEn      DateTime @default(now())

  @@unique([usuarioId, versionPolitica])
  @@index([usuarioId])
  @@map("consentimientos_tratamiento")
}
