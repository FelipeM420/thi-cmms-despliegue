# Copia este archivo a ".env" y ajusta los valores.
# Para la fase de tesis, DATABASE_URL puede apuntar a una instancia gratuita
# de PostgreSQL (Supabase, Neon o Railway) — costo cero durante el desarrollo.

DATABASE_URL="postgresql://usuario:password@localhost:5432/thi_cmms?schema=public"

# Clave para firmar los JWT de sesión. Genera una propia, larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor NO arranca con este valor de ejemplo, con uno corto ni con un
# secreto que haya estado publicado en el repositorio.
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_LARGO"
JWT_EXPIRES_IN="8h"

PORT=4000

# Dominio público del frontend desplegado (Vercel). Se usa para restringir CORS.
# Si necesitas más de uno, sepáralos por coma.
# FRONTEND_URL="https://thi-cmms.vercel.app"

# Vercel y Render son sitios distintos. Para que la cookie HttpOnly de archivos
# funcione entre ambos, en producción configura estas dos variables:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None

# Carpeta local donde se guardan fotos y manuales PDF de equipos (Sprint 1).
# En un despliegue real conviene moverlo a almacenamiento en la nube
# (S3, Cloudinary, Google Cloud Storage); para el prototipo de tesis basta
# con disco local.
UPLOADS_DIR="src/uploads"

# --- Opcionales ------------------------------------------------------------

# Cookie con la que el navegador pide fotos, manuales e informes de /uploads.
# Por defecto es "Secure" solo con NODE_ENV=production; con "false" se permite
# HTTP (p. ej. un despliegue interno sin certificado), con "true" se fuerza.
# COOKIE_SECURE=false

# Motor de OT automáticas (HU14): cada OT consume un consecutivo institucional.
# Con "false" no se generan solas (el botón "Generar órdenes de la semana" sigue).
# GENERAR_OT_AUTOMATICAS=false

# La semilla no corre con NODE_ENV=production (restablece contraseñas de demo).
# PERMITIR_SEED_EN_PRODUCCION=si

# Solo para las pruebas de integración (npm run test:integracion). Debe ser una
# base DESECHABLE cuyo nombre contenga "pruebas" o "test": la suite vacía sus tablas.
# THI_TEST_DATABASE_URL="postgresql://usuario:clave@localhost:5432/thi_cmms_pruebas?schema=public"
