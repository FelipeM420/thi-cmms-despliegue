# Copia este archivo a ".env.local" (no se versiona) y ajusta los valores.
# En Vercel, configúralos en Settings > Environment Variables.

# URL pública del backend (Render). En desarrollo se deja vacía: Vite reenvía /api.
# VITE_API_URL="https://tu-backend.onrender.com"

# Llave del cifrado de payloads (AES-256-GCM). Debe ser EXACTAMENTE el mismo valor
# de PAYLOAD_ENCRYPTION_KEY del backend. Queda incluida en el bundle público:
# nunca uses aquí un secreto JWT. Sin ella, `npm run build` se detiene.
VITE_PAYLOAD_ENCRYPTION_KEY=""
